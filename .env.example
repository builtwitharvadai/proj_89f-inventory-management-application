# Copy this file to .env and replace the placeholder values.
# Never commit real secrets or credentials.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the backend API server listens on
PORT=3000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>?schema=public

# Redis connection string used for caching and background job queues
REDIS_URL=redis://localhost:6379

# Secret used to sign JSON Web Tokens; use a long, random value
JWT_SECRET=<replace-with-a-long-random-secret>

# Lifetime of issued JSON Web Tokens (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Origin allowed to call the API via CORS (the frontend dev server URL)
CORS_ORIGIN=http://localhost:5173

# Base URL the frontend uses to reach the backend API
VITE_API_URL=http://localhost:3000/api

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
